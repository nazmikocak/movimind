# ── Harici film API anahtarları (madde 16) ──────────────────
# TMDb: https://www.themoviedb.org/settings/api  (ücretsiz)
# OMDb: https://www.omdbapi.com/apikey.aspx       (ücretsiz)
# Boş bırakılırsa sistem çalışır; sadece oyuncu/IMDb-puanı/fragman boş döner.
TMDB_API_KEY=
OMDB_API_KEY=

# ── Model otomasyonu ────────────────────────────────────────
# true → her açılışta modeli yeniden eğitir; false → mevcut modeli kullanır.
RETRAIN_ON_START=false

# ── Veri temizleme / örneklem ───────────────────────────────
FILM_MIN_RATINGS=75
USER_MIN_RATINGS=30
# Eşiği geçen kullanıcılardan alınacak alt-örneklem (0 = tümü). Matrisi küçültür.
USER_SAMPLE=40000
RANDOM_SEED=42

# ── Model ───────────────────────────────────────────────────
KNN_K=10
EVAL_SAMPLE_USERS=1500

# ── Server ──────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8000
