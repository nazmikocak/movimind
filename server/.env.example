# Harici film API'leri
# Anahtar alma: https://www.themoviedb.org/settings/api ve https://www.omdbapi.com/apikey.aspx (ücretsiz)
# Boş bırakılırsa sistem çalışır; oyuncu, IMDb puanı ve fragman gelmez.
TMDB_API_KEY=
OMDB_API_KEY=
# Kart posterlerinin TMDb boyutu: w185, w342, w500 ...
TMDB_POSTER_SIZE=w342
# Film detayı bu kadar günden eskiyse ziyaret anında yenilenir
EXTERNAL_CACHE_TTL_DAYS=30

# Veritabanı (Neon, Connect -> Connection pooling açık)
# Yerelde dev branch'inin adresi
DATABASE_URL=
# Yalnızca yerelde, `python main.py --publish-production` için canlı branch'in adresi
PRODUCTION_DATABASE_URL=
DB_POOL_MAX=4

# Otomasyon
# true (yerel): temizle, eğit, Neon'a yayınla; false (canlı): yalnızca servis et
RUN_PIPELINE=true
# true: her açılışta modeli yeniden eğitir
RETRAIN_ON_START=false

# Veri temizleme ve örneklem
FILM_MIN_RATINGS=75
USER_MIN_RATINGS=30
# Eşiği geçen kullanıcılardan alınacak örneklem (0: tümü)
USER_SAMPLE=40000
RANDOM_SEED=42

# Model
KNN_K=10
EVAL_SAMPLE_USERS=1500
# Bir sorguda hesaplanan en fazla komşu (/recommend en fazla 50 x 8 = 400 kullanır)
KNN_MAX_NEIGHBORS=400

# Server
HOST=127.0.0.1
PORT=8000
# Canlıda (Render) true: server 10 dk'da bir kendi adresine istek atarak uyanık kalır
KEEPALIVE_ENABLED=false
# Virgülle ayrılmış izinli arayüz adresleri (canlıda: https://movimind-web.vercel.app)
CORS_ORIGINS=http://localhost:5173